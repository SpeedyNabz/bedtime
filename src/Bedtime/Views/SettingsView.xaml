<UserControl
    x:Class="Bedtime.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="12,12,16,16" Spacing="4">
        <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,*">
            <Button
                AutomationProperties.Name="Back"
                Command="{x:Bind ViewModel.CloseSettingsCommand}"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Settings" />
        </Grid>

        <TextBlock
            Margin="4,4,0,4"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="Reminders" />

        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Text="Before bedtime" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                    <CheckBox Content="2 hrs" IsChecked="{x:Bind ViewModel.Lead120, Mode=TwoWay}" />
                    <CheckBox
                        Grid.Column="1"
                        Content="1 hr"
                        IsChecked="{x:Bind ViewModel.Lead60, Mode=TwoWay}" />
                    <CheckBox
                        Grid.Row="1"
                        Content="30 mins"
                        IsChecked="{x:Bind ViewModel.Lead30, Mode=TwoWay}" />
                    <CheckBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Content="15 mins"
                        IsChecked="{x:Bind ViewModel.Lead15, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" Text="At bedtime" />
                <ToggleSwitch
                    Grid.Column="1"
                    MinWidth="0"
                    AutomationProperties.Name="Remind me at bedtime"
                    IsOn="{x:Bind ViewModel.RemindAtBedtime, Mode=TwoWay}"
                    OffContent="Off"
                    OnContent="On" />
            </Grid>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Keep reminding me" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="After bedtime, while I'm still using my PC"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Keep reminding me after bedtime"
                        IsOn="{x:Bind ViewModel.NudgeAfterBedtime, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                </Grid>
                <Grid
                    ColumnDefinitions="*,Auto"
                    Visibility="{x:Bind ViewModel.NudgeAfterBedtime, Mode=OneWay}">
                    <TextBlock VerticalAlignment="Center" Text="Every" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="112"
                        AutomationProperties.Name="Reminder interval"
                        ItemsSource="{x:Bind ViewModel.NudgeIntervalOptions}"
                        SelectedIndex="{x:Bind ViewModel.NudgeIntervalIndex, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" Text="Snooze for" />
                <ComboBox
                    Grid.Column="1"
                    MinWidth="112"
                    AutomationProperties.Name="Snooze length"
                    ItemsSource="{x:Bind ViewModel.SnoozeOptions}"
                    SelectedIndex="{x:Bind ViewModel.SnoozeIndex, Mode=TwoWay}" />
            </Grid>
        </Border>

        <TextBlock
            Margin="4,12,0,4"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="General" />

        <Border Style="{StaticResource CardStyle}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" Text="Start with Windows" />
                <ToggleSwitch
                    Grid.Column="1"
                    MinWidth="0"
                    AutomationProperties.Name="Start with Windows"
                    IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                    OffContent="Off"
                    OnContent="On" />
            </Grid>
        </Border>

        <Grid
            Margin="0,12,0,0"
            ColumnDefinitions="*,*"
            ColumnSpacing="8">
            <Button
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.SendTestCommand}"
                Content="Test reminder" />
            <Button
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.QuitCommand}"
                Content="Quit Bedtime" />
        </Grid>
    </StackPanel>
</UserControl>
